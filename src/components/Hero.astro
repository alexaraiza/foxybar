---
import { Image } from 'astro:assets';
import backgroundImage from '../assets/img-6.jpg';
import foxyCrestImage from '../assets/foxy-crest.png';
---

<div class="hero">
  <Image src={backgroundImage} alt="" class="background" />
  <Image src={foxyCrestImage} alt="" class="foreground" />
</div>
<style>
  .hero {
    display: grid;
    height: 90vh;
    place-items: center;
  }
  .hero img.background {
    height: calc(90vh - 1rem);
    object-fit: cover;
    opacity: 0.2;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: -9;
  }
  .hero img.foreground {
    max-height: 50vh;
    max-width: 70%;
    height: auto;
    width: auto;
  }
</style>
