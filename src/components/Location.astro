  <div>
    <div class="mapa">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2993.712793680005!2d2.161774076384669!3d41.380324271300736!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4a260063c5051%3A0x6ce97e104a7b48a3!2sFoxy%20Bar!5e0!3m2!1sen!2ses!4v1791016709582!5m2!1sen!2ses" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
