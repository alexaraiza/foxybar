<section id="donde-estamos">
  <h2>Dónde estamos</h2>

  <div class="mapa">
    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2993.712793680005!2d2.161774076384669!3d41.380324271300736!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4a260063c5051%3A0x6ce97e104a7b48a3!2sFoxy%20Bar!5e0!3m2!1sen!2ses!4v1791016709582!5m2!1sen!2ses" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>

  <div class="info">
    <div>
      <h3>Dirección</h3>
      <div>Carrer de la Riera Alta, 59<br>08001 Barcelona</div>
    </div>
    <div>
      <h3>Horario</h3>
      <div>
        <div>De domingo a jueves de 17:30 a 02:00</div>
        <div>Viernes y sábados de 17:30 a 03:00</div>
      </div>
    </div>
  </div>
</section>
<style>
  .mapa {
    display: flex;
    height: 20rem;
    justify-content: center;
    max-width: 28rem;
    width: 100%;
  }
  @media screen and (min-width: 768px) {
    #donde-estamos {
      display: grid;
      grid: subgrid / subgrid;
      grid-area: 1 / 1 / span 3 / span 2;
      margin-top: -3rem;
      padding-top: 4rem;
      place-items: center;
    }
    .mapa {
      grid-area: 1 / 1 / span 3;
      height: 100%;
    }
    #donde-estamos h2 {
      grid-area: 1 / 2;
      margin-top: clamp(2rem, 3vw, 3rem);
    }
    .mapa {
      max-width: unset;
    }
    .info {
      grid-area: 2 / 2;
    }
  }
</style>
